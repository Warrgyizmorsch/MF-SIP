<+>import 'package:cached_network_image/cached_network_image.dart';\nimport 'package:flutter/material.dart';\n\nimport '../shimmer/shimmer.dart';\n\nclass CustomCachedImage extends StatelessWidget {\n  final String? imageUrl;\n  final double size;\n  final double radius;\n\n  const CustomCachedImage({\n    super.key,\n    required this.imageUrl,\n    this.size = 40.0,\n    this.radius = 20.0,\n  });\n\n  @override\n  Widget build(BuildContext context) {\n    final double pixelRatio = MediaQuery.of(context).devicePixelRatio;\n\n    // Calculate memory cache size based on physical pixels\n    final int cacheSize = (size * pixelRatio).toInt();\n\n    return ClipRRect(\n      borderRadius: BorderRadius.circular(radius),\n      child: CachedNetworkImage(\n        imageUrl: imageUrl ?? '',\n        width: size,\n        height: size,\n        fit: BoxFit.cover,\n\n        memCacheHeight: cacheSize,\n        memCacheWidth: cacheSize,\n\n        fadeInDuration: const Duration(milliseconds: 300),\n        placeholder: (context, url) =>\n            UShimmerEffect(width: size, height: size, radius: radius),\n        errorWidget: (context, url, error) => Container(\n          width: size,\n          height: size,\n          color: Colors.grey.shade200,\n          child: Icon(Icons.image_not_supported_outlined, color: Colors.black),\n        ),\n      ),\n    );\n  }\n}\n
